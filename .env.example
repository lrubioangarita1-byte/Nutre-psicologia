# URL pública del sitio (sin / final). En Vercel: https://laurarubiopsicologia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Correos con acceso al panel /admin (separados por coma). Deben existir como usuarios en Supabase Auth.
ADMIN_EMAILS=lrubioangarita1@gmail.com
# Correos que reciben alertas de riesgo y casos nuevos (por defecto, ADMIN_EMAILS)
ALERT_EMAILS=lrubioangarita1@gmail.com

# Resend (https://resend.com) — el dominio del remitente debe estar verificado
RESEND_API_KEY=
EMAIL_FROM="Laura Rubio · Psicología <informes@laurarubiopsicologia.com>"
EMAIL_REPLY_TO=Lrubioangarita1@gmail.com

# Wompi (COP) — Panel de comercio → Desarrolladores
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Stripe (USD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Solo desarrollo local: permite "pagar" sin cobrar. Se ignora en producción.
PAYMENTS_BYPASS=false
